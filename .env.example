# Mergelio — local build configuration.
#
# Copy this file and fill in only what you need:
#
#     cp .env.example .env
#
# `.env` is gitignored and never leaves your machine. Every value below is
# optional. With no `.env` at all, Mergelio still builds and runs locally on
# macOS, Windows and Linux — the macOS build is simply ad-hoc signed instead
# of Developer ID signed, which is all a local install needs.
#
# Values already present in your shell environment take precedence over this
# file, so one-off overrides work without editing anything:
#
#     MACOS_SIGN_IDENTITY="Developer ID Application: ..." ./scripts/build-macos-dmg.sh


# ─── Application ─────────────────────────────────────────────────────────────

# Product name used to locate the built .app and to name the DMG.
APP_NAME=Mergelio

# Directory that release artifacts are written to.
DIST_DIR=dist


# ─── macOS code signing (optional) ───────────────────────────────────────────
#
# Only needed to produce a build that other machines will run without
# Gatekeeper warnings. Requires a paid Apple Developer account. Leave empty
# to build for yourself.

# Full name of your Developer ID certificate, exactly as it appears in the
# keychain. List the ones you have with:
#
#     security find-identity -v -p codesigning
#
# Example: Developer ID Application: Jane Doe (ABCDE12345)
MACOS_SIGN_IDENTITY=

# Apple Developer Team ID, e.g. ABCDE12345. Used as DEVELOPMENT_TEAM in the
# Xcode build. If left empty it is read from the parentheses in
# MACOS_SIGN_IDENTITY above.
MACOS_TEAM_ID=

# Entitlements applied when re-signing the release bundle. Override only if
# you keep them somewhere else.
MACOS_ENTITLEMENTS=macos/Runner/Release.entitlements


# ─── macOS notarization (optional) ───────────────────────────────────────────
#
# Requires MACOS_SIGN_IDENTITY. Create the keychain profile once:
#
#     xcrun notarytool store-credentials <profile-name> \
#       --apple-id <your-apple-id> \
#       --team-id <TEAM_ID> \
#       --password <app-specific-password>
#
# Your Apple ID and app-specific password stay in the macOS keychain — only
# the profile name is referenced here, so this file holds no credentials.
# Leave empty to build and package a signed DMG without notarizing it.
MACOS_NOTARY_PROFILE=


# ─── Linux package signing (optional) ────────────────────────────────────────
#
# Only affects scripts/build-linux-rpm.sh. Leave empty and the package is built
# unsigned, which is all a local install needs. The .deb is never signed: dpkg
# does not check package signatures, only apt checks repositories.

# Key to sign the .rpm with, as a fingerprint, key ID or user ID that gpg can
# resolve in your keyring. List yours with:
#
#     gpg --list-secret-keys --keyid-format=long
RPM_SIGN_KEY=

# File holding the passphrase of that key. rpm drives gpg without a terminal,
# so a protected key cannot be unlocked by a prompt. Leave empty for a key with
# no passphrase.
RPM_SIGN_PASSPHRASE_FILE=
