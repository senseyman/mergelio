[Desktop Entry]
Type=Application
Name=Mergelio
GenericName=Git Client
Comment=Free, cross-platform visual Git client
# Both packages install the app under /opt and link it onto PATH here. Name the
# link outright instead of relying on a bare name: a bare Exec makes the shell
# look the program up in whatever PATH it inherited, and it refuses to start the
# entry when that lookup fails. TryExec hides the entry if the link is gone
# rather than leaving a launcher that errors out.
Exec=/usr/bin/mergelio
TryExec=/usr/bin/mergelio
Icon=com.mergelio.mergelio
Terminal=false
Categories=Development;RevisionControl;
Keywords=git;version control;vcs;
# The runner calls g_set_prgname(APPLICATION_ID), so the window reports this
# as its WM class. It has to match or the shell shows a generic icon in the
# dock instead of associating the window with this entry.
StartupWMClass=com.mergelio.mergelio
StartupNotify=true
