// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Mergelio

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.mergelio.mergelio

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.mergelio. All rights reserved.

// Code signing. SigningDefaults.xcconfig ships ad-hoc values so that a fresh
// clone builds without an Apple Developer account. Signing.xcconfig is written
// from .env by scripts/build-macos-dmg.sh, is gitignored, and overrides them when
// present — the leading `#include?` makes its absence a no-op.
#include "SigningDefaults.xcconfig"
#include? "Signing.xcconfig"
