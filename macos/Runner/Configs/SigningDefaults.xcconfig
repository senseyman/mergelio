// Default code-signing settings for the Runner target.
//
// These produce an ad-hoc signed build, which runs fine on the machine that
// built it. That keeps a fresh clone buildable without an Apple Developer
// account.
//
// To build a distributable, Developer ID signed app, put your values in .env
// and run scripts/build-macos-dmg.sh. It writes Signing.xcconfig next to this file,
// which is included afterwards and overrides everything here.

MERGELIO_CODE_SIGN_IDENTITY = -
MERGELIO_TEAM_ID =

// The hardened runtime enforces library validation, which only loads libraries
// signed by the same team as the app, or by Apple. An ad-hoc app has no team,
// so every framework it embeds gets rejected and it dies at launch with
// "different Team IDs". Only notarization needs the hardened runtime, and only
// the Developer ID build is notarized -- that build turns it back on.
MERGELIO_HARDENED_RUNTIME = NO
